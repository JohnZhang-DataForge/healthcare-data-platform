{
  "properties": {
    "description": "Invoke OMOP snapshot Notebook after export manifest is READY.",
    "activities": [
      {
        "name": "LoadOmopSnapshot",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "notebookId": "{{ .NotebookId }}",
          "workspaceId": "{{ .WorkspaceId }}",
          "parameters": {
            "export_id": {
              "value": {
                "value": "@pipeline().parameters.export_id",
                "type": "Expression"
              },
              "type": "string"
            },
            "manifest_uri": {
              "value": {
                "value": "@pipeline().parameters.manifest_uri",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        }
      }
    ],
    "parameters": {
      "export_id": {
        "type": "String",
        "defaultValue": ""
      },
      "manifest_uri": {
        "type": "String",
        "defaultValue": ""
      }
    }
  }
}
