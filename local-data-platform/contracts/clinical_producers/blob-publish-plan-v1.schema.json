{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Healthcare multi-hospital immutable Azure Blob publish input plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hospital_id",
    "feed_id",
    "request_id",
    "source_manifest_sha256",
    "target_format",
    "verification_state",
    "objects",
    "skipped_non_admissions"
  ],
  "properties": {
    "schema_version": {
      "const": "healthcare-azure-blob-publish-plan-v1"
    },
    "hospital_id": {
      "type": "string",
      "pattern": "^(?!demo-)[a-z][a-z0-9-]{2,63}$"
    },
    "feed_id": {
      "type": "string",
      "pattern": "^(?!demo-)[a-z][a-z0-9-]{2,63}$"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{7,65}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target_format": {
      "enum": [
        "FHIR_R4",
        "HL7_V2"
      ]
    },
    "verification_state": {
      "enum": [
        "SOURCE_HANDOFF_VERIFIED",
        "OIE_HL7_READBACK_VERIFIED"
      ]
    },
    "skipped_non_admissions": {
      "type": "integer",
      "minimum": 0
    },
    "objects": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "size_bytes",
          "sha256",
          "source_event_id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "source_event_id": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 199
          }
        }
      }
    }
  }
}
