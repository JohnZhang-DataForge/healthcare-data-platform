{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthea generated local asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "request_sha256",
    "status",
    "files",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "const": "synthea-new-generation-manifest-v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{7,65}$"
    },
    "request_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "const": "SOURCE_GENERATED_VALIDATED"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "format",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "enum": [
              "CSV",
              "FHIR_R4"
            ]
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "csv_patient_rows",
        "csv_encounter_rows",
        "fhir_bundles",
        "fhir_patients",
        "fhir_encounters"
      ],
      "additionalProperties": false,
      "properties": {
        "csv_patient_rows": {
          "type": "integer",
          "minimum": 0
        },
        "csv_encounter_rows": {
          "type": "integer",
          "minimum": 0
        },
        "fhir_bundles": {
          "type": "integer",
          "minimum": 0
        },
        "fhir_patients": {
          "type": "integer",
          "minimum": 0
        },
        "fhir_encounters": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
