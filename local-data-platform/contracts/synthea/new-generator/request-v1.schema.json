{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthea parameterized NEW_ONLY request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "generation_mode",
    "population",
    "state",
    "seed",
    "reference_date",
    "output_formats"
  ],
  "properties": {
    "schema_version": {
      "const": "synthea-new-generation-request-v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{7,65}$"
    },
    "generation_mode": {
      "const": "NEW_ONLY"
    },
    "population": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "city": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z][A-Za-z .'-]{0,79}$"
    },
    "seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854776000
    },
    "clinician_seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854776000
    },
    "reference_date": {
      "type": "string",
      "pattern": "^[0-9]{8}$"
    },
    "output_formats": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CSV",
          "FHIR_R4"
        ]
      }
    }
  }
}
