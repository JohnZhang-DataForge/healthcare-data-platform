{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simulated hospital feed profile; separate from Synthea generation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "hospital_id",
    "feed_id",
    "location",
    "generation_defaults",
    "delivery"
  ],
  "properties": {
    "schema_version": {
      "const": "synthea-hospital-feed-profile-v1"
    },
    "hospital_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "feed_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "city"
      ],
      "properties": {
        "state": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generation_defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "population",
        "seed",
        "reference_date"
      ],
      "properties": {
        "population": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "seed": {
          "type": "integer",
          "minimum": 1
        },
        "reference_date": {
          "type": "string",
          "pattern": "^[0-9]{8}$"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_format",
        "target_format",
        "transformer"
      ],
      "properties": {
        "source_format": {
          "const": "FHIR_R4"
        },
        "target_format": {
          "enum": [
            "FHIR_R4",
            "HL7_V2"
          ]
        },
        "transformer": {
          "enum": [
            "DIRECT",
            "OIE"
          ]
        }
      }
    }
  }
}
